# Base image: python 3.12-slim, pinned by its multi-arch index digest.
# Upstream: https://github.com/docker-library/python — published as Docker
# Hub's official `python` repository. The tag records what the digest stands
# for; Docker builds from the digest. Generated by `make pin-base` — never
# hand-edit the digest. `make check-base-image` (in `make checks`) fails when
# the tag has moved on.
FROM python:3.12-slim@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b

RUN apt-get update && apt-get install -y --no-install-recommends openssl gosu yaz \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 shelf

WORKDIR /app

COPY requirements.txt .
# requirements.txt is a generated hashed lock (make lock); --require-hashes makes a
# lock that lost its hashes fail the build instead of installing unchecked.
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY app/ ./app/
COPY static/ ./static/
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

EXPOSE 18888

# Entrypoint runs as root for cert generation, then drops to shelf user
CMD ["./entrypoint.sh"]
