#: static/js/item_edit.js:53 static/js/item_edit.js:140
msgid "Camera requires HTTPS. Open Shelf through an HTTPS reverse proxy, or leave SHELF_TLS on."
msgstr "La fotocamera richiede HTTPS. Apri Shelf tramite un reverse proxy HTTPS o lascia attivo SHELF_TLS."

#: static/js/item_edit.js:55 static/js/item_edit.js:142
