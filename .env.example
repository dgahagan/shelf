# Shelf Docker Compose configuration
# Copy to .env and customize as needed

# Docker Compose project name (used to namespace containers)
# COMPOSE_PROJECT_NAME=shelf-dev

# Container name
# SHELF_CONTAINER=shelf-dev

# Application port (HTTPS by default; plain HTTP with SHELF_TLS=off)
# SHELF_PORT=18889

# Host path for data volume (database, covers, certs)
# SHELF_DATA=./data-dev

# Additional DNS/IP entries for the self-signed TLS cert
# CERT_SAN=IP:192.168.1.100,DNS:shelf,DNS:localhost

# Built-in TLS listener: on (default) or off. Set off only behind a reverse
# proxy that terminates TLS, and set SHELF_TRUST_PROXY to that proxy.
# SHELF_TLS=on

# Address(es) of the reverse proxy in front of Shelf, comma-separated IPs or
# CIDRs. Forwarded headers are honoured only from these peers, walking
# X-Forwarded-For from the right. Leave unset without a proxy.
# SHELF_TRUST_PROXY=127.0.0.1

# JWT signing key. If unset, generated at data/signing.key
# (never stored in the database).
# SECRET_KEY=

# How long a login lasts, in whole days (1-365). A session in use is renewed
# past half its length, so a regular user is never logged out.
# SHELF_SESSION_DAYS=7

# Encryption key for API credentials stored in the DB. If unset, a key is
# auto-generated at data/encryption.key (kept out of DB backups either way).
# Setting it here means the data directory alone is not enough to decrypt
# stored credentials. Generate with: openssl rand -hex 32
# SHELF_ENCRYPTION_KEY=

# Optional Google Books API key. Anonymous Google Books lookups remain enabled
# when this is unset. The key is sent only in the X-Goog-Api-Key header.
# GOOGLE_BOOKS_API_KEY=
